{
  "name": "holdings",
  "private": true,
  "version": "0.2.0",
  "description": "Everything your side projects run on, in one place: domains, servers, repos, accounts, subscriptions and what each project costs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chmuzamil/holdings.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api": "node server/domain-api.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/mcp",
    "build:server": "esbuild packages/server/src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=packages/server/dist/server.js",
    "server": "node packages/server/dist/server.js",
    "build:mcp": "esbuild packages/mcp/src/index.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"#!/usr/bin/env node\" --outfile=packages/mcp/dist/holdings-mcp.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.17.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
