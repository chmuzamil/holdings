# Optional: GitHub Enterprise API base for the repo fetcher (defaults to https://api.github.com)
# VITE_GITHUB_API_BASE=https://api.github.com

# Optional: send errors in the browser to Sentry or GlitchTip (build time).
# For a public site, add the DSN's origin to connect-src in your CSP.
# VITE_SENTRY_DSN=https://<public-key>@errors.example/<project-id>

# Optional: send server errors to Sentry or GlitchTip (self-hosted server, runtime)
# SENTRY_DSN=https://<public-key>@errors.example/<project-id>

# Optional: domain lookup API (npm run api)
# HOLDINGS_API_PORT=4180

# Optional: allow one exact cross-origin caller of the lookup API
# HOLDINGS_ALLOWED_ORIGIN=https://holdings.example
